/* Polish over Fusion; colors match the palette in Theme.cpp. QComboBox,
 * QSpinBox and QCheckBox stay unstyled: partial QSS on those discards the
 * whole native rendering, arrows included. */

QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #c8cdd5;
    border-radius: 6px;
    padding: 5px 16px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: #f2f4f7;
}
QPushButton:pressed {
    background-color: #e6e9ee;
}
QPushButton:default {
    background-color: #3584e4;
    border-color: #2b70c4;
    color: #ffffff;
}
QPushButton:default:hover {
    background-color: #2f79d5;
}
QPushButton:default:pressed {
    background-color: #2a6cc0;
}
QPushButton:disabled {
    background-color: #f2f3f5;
    border-color: #dfe2e7;
    color: #a0a6b0;
}
QPushButton:flat {
    background: transparent;
    border: none;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 3px;
}
QToolButton:hover {
    background-color: #e8ebef;
}
QToolButton:pressed {
    background-color: #dde1e7;
}

QToolBar {
    background: transparent;
    border: none;
    padding: 2px;
    spacing: 4px;
}

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #c8cdd5;
    border-radius: 6px;
    padding: 4px 8px;
}
QLineEdit:focus {
    border-color: #3584e4;
}
QLineEdit:disabled {
    background-color: #f2f3f5;
    color: #a0a6b0;
}

QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 14px;
}
QTabBar::tab:selected {
    border-bottom-color: #3584e4;
}
QTabBar::tab:hover:!selected {
    background-color: #eceef2;
}

QHeaderView::section {
    background-color: #f4f5f7;
    border: none;
    border-right: 1px solid #e0e3e8;
    border-bottom: 1px solid #d3d7dd;
    padding: 4px 8px;
}

QTableView {
    gridline-color: #e3e6ea;
}
QTableView, QTreeView, QListView, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #d5d9df;
}
QTreeView::item {
    padding: 2px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}
QScrollBar::handle {
    background-color: #c3c9d1;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    min-height: 30px;
}
QScrollBar::handle:horizontal {
    min-width: 30px;
}
QScrollBar::handle:hover {
    background-color: #a9b1bb;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #c8cdd5;
    padding: 4px;
}
QMenu::item {
    border-radius: 4px;
    padding: 5px 24px 5px 12px;
}
QMenu::item:selected {
    background-color: #3584e4;
    color: #ffffff;
}
QMenu::separator {
    background-color: #e3e6ea;
    height: 1px;
    margin: 4px 8px;
}

QGroupBox {
    border: 1px solid #d5d9df;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 4px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    color: #5c6470;
}

QToolTip {
    background-color: #ffffff;
    border: 1px solid #c8cdd5;
    color: #23272e;
    padding: 4px 6px;
}

QStatusBar::item {
    border: none;
}
