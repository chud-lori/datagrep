/* Polish over Fusion; @token@ colors are substituted per light/dark table in
 * Theme.cpp. QComboBox/QSpinBox/QCheckBox stay unstyled: partial QSS on those
 * discards the whole native rendering, arrows included. */

QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

QPushButton {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 5px 16px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: @surfaceHover@;
}
QPushButton:pressed {
    background-color: @surfacePressed@;
}
QPushButton:default {
    background-color: @accent@;
    border-color: @accentBorder@;
    color: #ffffff;
}
QPushButton:default:hover {
    background-color: @accentHover@;
}
QPushButton:default:pressed {
    background-color: @accentPressed@;
}
QPushButton:disabled {
    background-color: @disabledSurface@;
    border-color: @disabledBorder@;
    color: @disabledText@;
}
QPushButton:flat {
    background: transparent;
    border: none;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 3px;
}
QToolButton:hover {
    background-color: @hoverTint@;
}
QToolButton:pressed {
    background-color: @pressedTint@;
}

QToolBar {
    background: transparent;
    border: none;
    padding: 2px;
    spacing: 4px;
}

QLineEdit {
    background-color: @viewBg@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 4px 8px;
}
QLineEdit:focus {
    border-color: @accent@;
}
QLineEdit:disabled {
    background-color: @disabledSurface@;
    color: @disabledText@;
}

QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 14px;
}
QTabBar::tab:selected {
    border-bottom-color: @accent@;
}
QTabBar::tab:hover:!selected {
    background-color: @tabHover@;
}

QHeaderView::section {
    background-color: @headerBg@;
    border: none;
    border-right: 1px solid @headerBorderRight@;
    border-bottom: 1px solid @headerBorderBottom@;
    padding: 4px 8px;
}

QTableView {
    gridline-color: @gridline@;
}
QTableView, QTreeView, QListView, QPlainTextEdit {
    background-color: @viewBg@;
    border: 1px solid @viewBorder@;
}
QTreeView::item {
    padding: 2px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}
QScrollBar::handle {
    background-color: @scrollHandle@;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    min-height: 30px;
}
QScrollBar::handle:horizontal {
    min-width: 30px;
}
QScrollBar::handle:hover {
    background-color: @scrollHandleHover@;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QMenu {
    background-color: @surface@;
    border: 1px solid @border@;
    padding: 4px;
}
QMenu::item {
    border-radius: 4px;
    padding: 5px 24px 5px 12px;
}
QMenu::item:selected {
    background-color: @accent@;
    color: #ffffff;
}
QMenu::separator {
    background-color: @separator@;
    height: 1px;
    margin: 4px 8px;
}

QGroupBox {
    border: 1px solid @viewBorder@;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 4px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    color: @mutedText@;
}

QToolTip {
    background-color: @surface@;
    border: 1px solid @border@;
    color: @tooltipText@;
    padding: 4px 6px;
}

QStatusBar::item {
    border: none;
}
