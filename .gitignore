/target
# per-crate build dirs used to avoid cargo lock contention
/target-*
.build
**/*.rs.bk
*.pdb
.DS_Store
ui/macos/.build
ui/macos/.bench
ui/macos/*.app
# scripts/make_dmg.sh output (same layout the release workflow uses)
/dist

# xtask is a standalone cargo project; its build dir is not covered by /target
xtask/target/

# generated by packaging/flatpak/generate-cargo-sources.sh — never committed
packaging/flatpak/cargo-sources.json
packaging/flatpak/flatpak-cargo-generator.py
# flatpak-builder work dirs (local builds)
.flatpak-builder/
# ui/gtk4 is a standalone cargo workspace, for the same reason
ui/gtk4/target/
